# Copy this file to .env and fill in your SMTP provider details.
# The website still stores leads in SQLite if SMTP is not configured.
LEADS_TO_EMAIL=you@example.com
EMAIL_FROM=your-sender@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Optional: defaults to ./leads.db
# DATABASE_PATH=./leads.db
